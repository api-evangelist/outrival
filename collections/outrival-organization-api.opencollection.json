{
  "opencollection": "1.0.0",
  "info": {
    "name": "OutRival Ai Chat Sessions Organization API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Organization",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "OrganizationController_getOrganization",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.outrival.com/rest/v1/organization",
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          }
        },
        {
          "info": {
            "name": "OrganizationController_generateOrganizationToken",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.outrival.com/rest/v1/organization/token",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          }
        }
      ]
    }
  ],
  "bundled": true
}